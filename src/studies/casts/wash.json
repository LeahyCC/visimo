{
  "id": "wash",
  "name": "Wash",
  "flow": "turbulent-fluid",
  "inks": ["dye-plumes"],
  "look": "warm-soft",
  "canvas": {
    "knobs": {
      "feedback.amount": 0.3,
      "feedback.decay": 0.68,
      "feedback.zoom": 1.00275,
      "feedback.rotate": 0.0006
    },
    "mapping": [
      { "from": "swell", "to": "feedback.decay", "gain": 0.04 },
      { "from": "beatPhase", "to": "feedback.zoom", "gain": 0.0025, "curve": "invert" },
      { "from": "harmonicChange", "to": "feedback.rotate", "gain": 0.001 },
      { "from": "energy", "to": "feedback.carry", "gain": 0.4 }
    ]
  },
  "overrides": {
    "dye-plumes": {
      "knobs": {
        "dyeDecay": 0.3,
        "intensity": 1,
        "saturation": 1,
        "dye": 3,
        "hitDye": 0.9,
        "colourShift": 0.5,
        "eventDye": 2
      },
      "mapping": [
        { "from": "energy", "to": "dye", "gain": 2.3 },
        { "from": "treble", "to": "hitDye", "gain": 1.2 },
        { "from": "lowEnd", "to": "colourShift", "gain": 0.25, "curve": "square" },
        { "from": "beatPulse", "to": "intensity", "gain": 0.3 },
        { "from": "energy", "to": "intensity", "gain": -0.12, "curve": "square" },
        { "from": "swell", "to": "intensity", "gain": -0.09, "curve": "square" },
        { "from": "hardness", "to": "intensity", "gain": -0.09, "curve": "square" }
      ]
    },
    "warm-soft": {
      "knobs": {
        "bloom.threshold": 0.9,
        "bloom.intensity": 0.28,
        "chromatic.amount": 0.0001,
        "chromatic.beat": 0.0015,
        "tonemap.shoulder": 0.55,
        "grain.amount": 0.008
      },
      "mapping": [{ "from": "beatPulse", "to": "bloom.intensity", "gain": 0.1 }]
    }
  }
}
